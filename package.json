{
  "name": "export-tree",
  "version": "1.0.1",
  "description": "Zero-config CLI that prints your project's directory tree with every export. Gitignore-aware, code-files only. Paste-ready for AI prompts or quick onboarding.",
  "type": "module",
  "bin": {
    "export-tree": "dist/cli.js",
    "etree": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "test": "tsx src/cli.ts ."
  },
  "keywords": [
    "directory-tree",
    "export-tree",
    "exports",
    "tree",
    "project-structure",
    "codebase-map",
    "cli",
    "typescript",
    "javascript",
    "ai-context",
    "llm",
    "code-map",
    "onboarding"
  ],
  "author": "Eloquence98",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Eloquence98/export-tree.git"
  },
  "homepage": "https://github.com/Eloquence98/export-tree",
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "ignore": "^7.0.6"
  }
}
